# =============================================
#  TELEGRAM AI BOT — Environment Variables
# =============================================
# Setelah menjalankan npm run db:seed-config,
# bagian CREDENTIALS di bawah sudah TIDAK DIPERLUKAN lagi
# (sudah tersimpan terenkripsi di database).
# Yang wajib tetap ada: DATABASE_URL, ENCRYPTION_KEY,
# BOT_MODE, WEBHOOK_PORT.

# =============================================
#  INFRASTRUKTUR (tetap di .env)
# =============================================
DATABASE_URL=postgresql://postgres:my_password@localhost:5284/db_telegram_bot?schema=public
PORT=5505
REDIS_URL=redis://localhost:6379
MIDTRANS_FINISH_URL=https://t.me/NgulikTelegram2Bot

PUBLIC_BASE_URL=https://48bk9bks-5505.asse.devtunnels.ms

# Kunci enkripsi untuk credentials di database
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN pernah ubah setelah credentials tersimpan — data akan tidak bisa didekripsi
ENCRYPTION_KEY=a8fa8fb4e14eae5b95fb945cf3884395f023b3822a6ea8e4dc33306f3432184b
JWT_SECRET=f4c5e56a56fd93f73bd401bd34819948900883ff6e9b527c3e9f077f2a34cd51

# =============================================
#  GOOGLE OAUTH 2.0
# =============================================
# Dapatkan dari: https://console.developers.google.com/
# 1. Create OAuth 2.0 Client ID (Web Application)
# 2. Authorized JavaScript origins: http://localhost:3000
# 3. Authorized redirect URIs: http://localhost:5505/api/auth/google/callback
GOOGLE_CLIENT_ID=241571848058-pqbr4e72qn8fbkarhn9ihvtksv1or3o3.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=https://f4fw4xdk-5505.asse.devtunnels.ms/api/auth/google/callback
