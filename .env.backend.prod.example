# Backend production env (telegram-ai-bot)
# Copy to .env.backend.prod and fill all values.

DATABASE_URL=postgresql://postgres:change_me@postgres:5432/db_telegram_bot?schema=public
WEBHOOK_PORT=3000
MIDTRANS_FINISH_URL=https://t.me/
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_long_random_secret
ENCRYPTION_KEY=replace_with_64_char_hex_key
NODE_ENV=production

# CORS allowed origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Required for Telegram webhook setup (must be HTTPS public URL)
PUBLIC_BASE_URL=https://api.your-domain.com
