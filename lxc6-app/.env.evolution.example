# env Evolution API — SALIN menjadi `.env.evolution` di direktori ini.
# Nilai non-rahasia diambil dari `/opt/evolution/.env` lxc-4 (Fase 0).
# Kredensial tetap PLACEHOLDER (keputusan pemilik).
#
# Variabel yang DISET OLEH COMPOSE (jangan ditulis di sini, akan ditimpa):
#   DATABASE_CONNECTION_URI, CACHE_REDIS_URI

# --- kunci API Evolution (samakan dengan EVOLUTION_API_KEY di .env.backend) ---
AUTHENTICATION_API_KEY=__GANTI_openssl_rand_hex_24__
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- session WhatsApp ---
# WAJIB sama dengan lxc-4. Jangan diubah tanpa alasan kuat (T4).
CONFIG_SESSION_PHONE_VERSION=2.3000.1034227922
CONFIG_SESSION_PHONE_CLIENT=Sellgram
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR=#175197

# --- server / CORS ---
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://evolution.coreapps.web.id
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# --- database (URI diisi compose) ---
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# --- cache (URI diisi compose) ---
CACHE_REDIS_ENABLED=true
CACHE_LOCAL_ENABLED=false
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false

# --- webhook (global dimatikan; webhook per-instance diatur dari backend) ---
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_ERRORS=false

# --- integrasi yang tidak dipakai ---
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
S3_ENABLED=false

# --- WhatsApp Business API (tidak dipakai) ---
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v20.0
WA_BUSINESS_LANGUAGE=en_US
WA_BUSINESS_TOKEN_WEBHOOK=

# --- lain-lain ---
LANGUAGE=en
DEL_INSTANCE=false
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE,DARK,WEBHOOKS
LOG_COLOR=true
LOG_BAILEYS=error
SENTRY_DSN=
