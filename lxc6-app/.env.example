# env level-compose untuk lxc-6 — SALIN menjadi `.env` di direktori ini.
# `.env` TIDAK boleh di-commit (lihat .gitignore repo).
#
# Semua password WAJIB hex/alfanumerik agar aman di dalam URL:
#   openssl rand -hex 24
#
# Penamaan sengaja beda dengan role di env lama: kunci internal dibuat baru
# karena data lama tidak dimigrasi (keputusan pemilik).

# --- password database & cache ---
POSTGRES_SUPERUSER_PASSWORD=__GANTI_HEX_24__
SELLGRAM_APP_PASSWORD=__GANTI_HEX_24__
EVOLUTION_DB_PASSWORD=__GANTI_HEX_24__
REDIS_PASSWORD=__GANTI_HEX_24__

# --- opsional: lokasi build context ---
# Default mengikuti layout lxc-6 (/opt/sellgram/{sellgram-be,sellgram-fe,telegram-bot-docker}).
# Di laptop, arahkan ke clone lokal agar `docker compose build` bisa diuji.
# SELLGRAM_BE_CONTEXT=../../sellgram-be
# SELLGRAM_FE_CONTEXT=../../sellgram-fe

# --- opsional: build-arg frontend (tertanam saat build, ubah = rebuild) ---
# NEXT_PUBLIC_API_URL=https://sellgram-api.coreapps.web.id
# NEXT_PUBLIC_SITE_URL=https://sellgram.coreapps.web.id

# --- opsional: URL Evolution dari sisi backend ---
# Default http://evolution:8080 (mode bridge). Nilai ini MENANG atas isi
# `.env.backend`, jadi ubah di sini bila Evolution dipindah ke network host.
# EVOLUTION_API_URL=http://evolution:8080
