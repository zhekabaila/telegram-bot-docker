# env backend — SALIN menjadi `.env.backend` di direktori ini, LALU ISI DI SERVER.
#
# PENTING (keputusan pemilik): file contoh ini hanya berisi PLACEHOLDER.
# Nilai asli kredensial pihak ketiga (Google OAuth, OpenRouter, Midtrans)
# diisi manual di server, tidak pernah masuk repo.
#
# Variabel yang DISET OLEH COMPOSE (jangan ditulis di sini, akan ditimpa):
#   DATABASE_URL, REDIS_URL, PORT, WEBHOOK_PORT, NODE_ENV, NODE_OPTIONS,
#   EVOLUTION_API_URL
# Daftar diambil dari env produksi lxc-2 lama + daftar variabel rencana Bagian 5.

# --- URL publik ---
NODE_ENV=production
PUBLIC_BASE_URL=https://sellgram-api.coreapps.web.id
ALLOWED_ORIGINS=https://sellgram.coreapps.web.id
MIDTRANS_FINISH_URL=https://t.me/NgulikTelegram2Bot

# --- kunci internal (BUAT BARU, jangan pakai nilai lama yang sudah bocor di git) ---
JWT_SECRET=__GANTI_openssl_rand_hex_32__
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=__GANTI_openssl_rand_hex_32__
# Opsional; jika kosong kode memakai ENCRYPTION_KEY
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_API_KEY=__GANTI_openssl_rand_hex_24__

# --- Google OAuth (placeholder) ---
GOOGLE_CLIENT_ID=__GANTI_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__GANTI_GOOGLE_CLIENT_SECRET__
GOOGLE_REDIRECT_URI=https://sellgram-api.coreapps.web.id/api/auth/google/callback

# --- Midtrans (placeholder) ---
PLATFORM_MIDTRANS_SERVER_KEY=__GANTI_MIDTRANS_SERVER_KEY__
PLATFORM_MIDTRANS_CLIENT_KEY=__GANTI_MIDTRANS_CLIENT_KEY__
PLATFORM_MIDTRANS_IS_PRODUCTION=false

# --- AI provider (placeholder) ---
OPENROUTER_API_KEY=__GANTI_OPENROUTER_API_KEY__
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
GEMINI_API_KEY=
GEMINI_MODEL=
AI_ENABLED=false

# --- opsional / tidak ada di env produksi lama (pakai default kode) ---
BOT_HEALTH_MONITOR_INTERVAL_MS=
BOT_HEALTH_CACHE_TTL_SECONDS=
DUMMY_SUPPLIER_SECRET=
